{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "AGENT_BUS hook", "timeout": 5 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "AGENT_BUS hook", "timeout": 5 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "AGENT_BUS hook", "timeout": 5 }] }],
    "PreToolUse": [{ "matcher": "Bash", "hooks": [{ "type": "command", "command": "AGENT_BUS hook", "timeout": 5 }] }],
    "PostToolUse": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "AGENT_BUS hook", "timeout": 5 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "AGENT_BUS hook", "timeout": 5 }] }, { "hooks": [{ "type": "command", "command": "AGENT_BUS hook --rewake", "asyncRewake": true, "timeout": 604800 }] }]
  }
}
